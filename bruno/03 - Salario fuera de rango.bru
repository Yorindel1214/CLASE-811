meta {
  name: 03 - Salario fuera de rango
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Luis",
    "apellidos": "Gómez",
    "correo_electronico": "luis@correo.com",
    "salario_base": 20000000
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("explica el rango permitido", function () {
    expect(res.getBody().error).to.equal("El salario_base debe estar entre 0 y 15.000.000");
  });
}

docs {
  Criterio: salario_base debe estar entre 0 y 15.000.000. Esperado: 400.
}
