meta {
  name: 08 - Buscar usuarios por correo
  type: http
  seq: 8
}

get {
  url: http://localhost:8080/api/v1/usuarios?correos=admin@crediya.com,{{correoNuevo}}
  body: none
  auth: bearer
}

params:query {
  correos: admin@crediya.com,{{correoNuevo}}
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devuelve los usuarios sin la clave", function () {
    const usuarios = res.getBody();
    expect(usuarios.length).to.be.at.least(1);
    usuarios.forEach((u) => expect(u).to.not.have.property("clave"));
  });
}

docs {
  HU4: el microservicio de Solicitudes usa este endpoint para mostrarle al asesor el nombre
  y el salario base de los clientes. Solo ADMIN o ASESOR. Esperado: 200.
}
