meta {
  name: 04 - Correo con formato invalido
  type: http
  seq: 4
}

post {
  url: http://localhost:8080/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Luis",
    "apellidos": "Gómez",
    "correo_electronico": "no-es-correo",
    "salario_base": 3000000
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("explica que el correo no es valido", function () {
    expect(res.getBody().error).to.equal("El correo electrónico no tiene un formato válido");
  });
}

docs {
  Criterio: correo_electronico debe tener formato de email valido. Esperado: 400.
}
